# Copy to .env. Choose unique storage credentials before the first start.
STORAGE_ACCESS_KEY=openseo
STORAGE_SECRET_KEY=replace-with-a-long-random-secret
# password: email and password accounts. The first visitor creates the
# admin account; invitations add the rest.
# local_noauth: no sign-in and one admin user, as the old Docker image ran;
# only for private networks.
AUTH_MODE=password
# The public URL of this installation, in either mode.
BETTER_AUTH_URL=http://localhost:3001
PORT=3001
# Optional feature credentials; these are set at initialization, never compiled.
# Leave a key empty until you have the real value: any non-empty value turns
# its features on, and a placeholder then fails on every call. After adding
# or changing one, apply it with:
#   docker compose up -d --force-recreate init web crawl-gateway
#
# DataForSEO (paid per call): keyword research, domain overview, backlinks,
# rank tracking, Local SEO ranking scans and AI visibility. Not the dashboard
# password: base64 of "login:password". See docs/DATAFORSEO_API_KEY.md.
DATAFORSEO_API_KEY=
# OpenRouter (paid per use): SAM, the AI assistant that writes reports, plus
# website research, summaries and AI visibility setup.
OPENROUTER_API_KEY=
# Optional OpenRouter model; empty uses the default.
OPENROUTER_MODEL=
# Your own Google OAuth app: connects Search Console and Google Analytics 4
# to projects. See docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Context.dev (optional, paid): JavaScript rendering for site audits.
CONTEXT_API_KEY=
# Google Map Tiles API (optional): the map behind Local SEO grids.
# See docs/GOOGLE_MAPS_SETUP.md.
GOOGLE_MAPS_API_KEY=
